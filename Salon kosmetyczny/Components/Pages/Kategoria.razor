@page "/kategorie"
@using Microsoft.EntityFrameworkCore
@using Salon_kosmetyczny.Data
@using Salon_kosmetyczny.Models
@inject SalonDbContext DbContext

<PageTitle>Kategorie - BeautySalon</PageTitle>

<h1>Kategorie Produktów</h1>

@* Miejsce na wyświetlanie błędów (np. próba usunięcia pełnej kategorii) *@
@if (komunikatBledu != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @komunikatBledu
        <button type="button" class="btn-close" @onclick="() => komunikatBledu = null"></button>
    </div>
}

<div class="row mt-4">
    <!-- Lewa kolumna: Tabela kategorii -->
    <div class="col-md-8 mb-4">
        @if (listaKategorii == null)
        {
            <p><em>Ładowanie...</em></p>
        }
        else
        {
            <div class="table-responsive shadow-sm">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nazwa kategorii</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kat in listaKategorii)
                        {
                            <tr>
                                <td>@kat.Id</td>
                                <td>@kat.Nazwa</td>
                                <td class="text-end">
                                    @* Przycisk wywołujący metodę z parametrem (przekazujemy obiekt kat) *@
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UsunKategorie(kat)">
                                        <i class="bi bi-trash"></i> Usuń
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Prawa kolumna: Szybki formularz dodawania -->
    <div class="col-md-4">
        <div class="card shadow-sm border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Nowa kategoria</h5>
            </div>
            <div class="card-body">
                <EditForm Model="nowaKategoria" OnValidSubmit="DodajKategorie">
                    <DataAnnotationsValidator />
                    
                    <div class="mb-3">
                        <label class="form-label">Nazwa nowej kategorii *</label>
                        <InputText @bind-Value="nowaKategoria.Nazwa" class="form-control" placeholder="np. Lakiery hybrydowe" />
                        <ValidationMessage For="@(() => nowaKategoria.Nazwa)" class="text-danger" />
                    </div>
                    
                    <button type="submit" class="btn btn-success w-100">Zapisz</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<KategoriaProduktu>? listaKategorii;
    private KategoriaProduktu nowaKategoria = new();
    private string? komunikatBledu;

    protected override async Task OnInitializedAsync()
    {
        await WczytajKategorie();
    }

    private async Task WczytajKategorie()
    {
        // Używamy Include, aby EF Core dociągnęło informację o powiązanych produktach
        listaKategorii = await DbContext.Kategorie_produktow
                                        .Include(k => k.Produkty)
                                        .ToListAsync();
    }

    private async Task DodajKategorie()
    {
        DbContext.Kategorie_produktow.Add(nowaKategoria);
        await DbContext.SaveChangesAsync();
        
        nowaKategoria = new KategoriaProduktu(); // Czyszczenie formularza
        komunikatBledu = null; // Czyszczenie ewentualnych błędów
        await WczytajKategorie(); // Odświeżenie tabeli
    }

    private async Task UsunKategorie(KategoriaProduktu kategoriaDoUsuniecia)
    {
        // ZABEZPIECZENIE: Nie pozwalamy usunąć kategorii, jeśli są w niej produkty!
        if (kategoriaDoUsuniecia.Produkty.Any())
        {
            komunikatBledu = $"Nie można usunąć kategorii '{kategoriaDoUsuniecia.Nazwa}', ponieważ są do niej przypisane produkty w magazynie!";
            return; // Przerwanie metody
        }

        // Jeśli kategoria jest pusta, kasujemy
        DbContext.Kategorie_produktow.Remove(kategoriaDoUsuniecia);
        await DbContext.SaveChangesAsync();
        
        komunikatBledu = null;
        await WczytajKategorie();
    }
}