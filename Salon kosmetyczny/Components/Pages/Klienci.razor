@page "/klienci"
@using Microsoft.EntityFrameworkCore
@using Salon_kosmetyczny.Data
@using Salon_kosmetyczny.Models 
@inject SalonDbContext DbContext

<PageTitle>Klienci - BeautySalon</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Baza Klientów</h1>
    <button class="btn btn-primary">
        <i class="bi bi-person-plus-fill"></i> Dodaj nowego klienta
    </button>
</div>

@if (listaKlientow == null)
{
    <p><em>Ładowanie danych z bazy...</em></p>
}
else if (!listaKlientow.Any())
{
    <div class="alert alert-warning">Brak klientów w bazie danych.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Imię</th>
                    <th>Nazwisko</th>
                    <th>Nr telefonu</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var klient in listaKlientow)
                {
                    <tr>
                        <td>@klient.Id</td>
                        <td>@klient.Imie</td>
                        <td>@klient.Nazwisko</td>
                        <td>@klient.NrTelefonu</td>
                        <td>@(string.IsNullOrEmpty(klient.Email) ? "- brak -" : klient.Email)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // Zmienna przechowująca listę klientów
    private List<Klient>? listaKlientow;

    // Metoda uruchamiana przy wejściu na stronę
    protected override async Task OnInitializedAsync()
    {
        // OrderBy układa ich alfabetycznie po nazwisku!
        listaKlientow = await DbContext.Klienci
                                       .OrderBy(k => k.Nazwisko)
                                       .ToListAsync();
    }
}